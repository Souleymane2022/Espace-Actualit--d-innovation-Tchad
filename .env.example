# Base de données PostgreSQL.
# En local  : postgresql://innov:innov@127.0.0.1:5432/innovtchad
# Sur Vercel : créez une base Neon via l'onglet Storage, la variable est ajoutée pour vous.
DATABASE_URL="postgresql://innov:innov@127.0.0.1:5432/innovtchad"
DATABASE_URL_UNPOOLED="postgresql://innov:innov@127.0.0.1:5432/innovtchad"

# Secret utilisé pour signer les cookies de session de l'espace d'administration.
# Générer une valeur aléatoire : openssl rand -hex 32
SESSION_SECRET="changez-moi-en-production"

# Compte administrateur créé par le script de peuplement (npm run db:seed)
ADMIN_EMAIL="admin@innovtchad.td"
ADMIN_PASSWORD="admin1234"
